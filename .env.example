# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# Variables are added here as each phase needs them.

# --- App ---
# Public base URL of the app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Phase 3: Supabase Postgres via Prisma) ---
# Supabase dashboard > Connect. Use the connection strings for the SAME project.
#
# Pooled connection string (Supavisor, transaction mode, port 6543). Used by the
# running app. Keep the pooler username form (postgres.<project-ref>).
DATABASE_URL=
# Direct connection string (port 5432). Used by `prisma migrate` and `prisma db seed`.
# If your network has no IPv6 route to the direct host, use the session-mode pooler
# string (port 5432 on the pooler host) here instead.
DIRECT_URL=
# Optional. A SEPARATE, throwaway database (never your real one) for the
# integration tests in src/server/*.integration.test.ts. When unset, those tests
# are skipped. The tests delete the rows they create, but use an empty database.
TEST_DATABASE_URL=
