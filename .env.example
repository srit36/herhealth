# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# Variables are added here as each phase needs them.

# --- App ---
# Public base URL of the app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (added in Phase 3: Supabase Postgres via Prisma) ---
# Pooled connection string (used by the running app).
DATABASE_URL=
# Direct connection string (used by Prisma migrations).
DIRECT_URL=